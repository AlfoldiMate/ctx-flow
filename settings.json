{
  "env": {
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "nu --stdin \"$CLAUDE_PROJECT_DIR/.claude/hooks/scripts/branch-nudge.nu\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "nu --stdin \"$CLAUDE_PROJECT_DIR/.claude/hooks/scripts/context-nudge.nu\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "nu --stdin \"$CLAUDE_PROJECT_DIR/.claude/hooks/scripts/read-guard.nu\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "nu --stdin \"$CLAUDE_PROJECT_DIR/.claude/hooks/scripts/idiom-nudge.nu\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "outputStyle": "ctx-flow"
}
